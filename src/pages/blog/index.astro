---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { slug: 'diseno-web-profesional-cdmx-emprendedores-2026', title: 'Diseño web profesional en CDMX para emprendedores 2026', excerpt: 'Descubre qué elementos son esenciales en un sitio web que convierte, por qué el diseño web profesional marca la diferencia y cómo elegir la agencia correcta en CDMX.', category: 'Diseño Web', date: 'Abril 2026', readTime: '8 min' },
  { slug: 'gestion-redes-sociales-negocios-mexico', title: 'Gestión de redes sociales para negocios en México', excerpt: '¿Llevas meses sin publicar? ¿Tu competencia aparece en todos lados mientras tú construyes audiencia desde cero? Descubre cómo una gestión profesional cambia el juego.', category: 'Redes Sociales', date: 'Abril 2026', readTime: '7 min' },
  { slug: 'agencia-marketing-digital-cdmx-como-elegir-2026', title: 'Agencia de marketing digital en CDMX: cómo elegir bien en 2026', excerpt: 'No todas las agencias son iguales. Aprende qué criterios usar para elegir una agencia de marketing digital en CDMX que realmente genere resultados para tu negocio.', category: 'Marketing Digital', date: 'Abril 2026', readTime: '9 min' },
];
---
<Layout title="Blog de Marketing Digital" description="Blog de Marketing Solutions MX. Artículos, guías y estrategias de marketing digital, SEO, diseño web y redes sociales para negocios en México." canonical="/blog">
  <section class="page-hero">
    <div class="container">
      <p class="label">Blog</p>
      <h1>Ideas para <span class="grad-text">crecer</span> en digital</h1>
      <p>Artículos prácticos de marketing digital, SEO, diseño web y redes sociales para empresas en México.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="posts-grid">
        {posts.map((post, i) => (
          <article class={`post-card card-border ${i === 0 ? 'post-featured' : ''}`}>
            <div class="post-meta">
              <span class="post-cat">{post.category}</span>
              <span class="post-date">{post.date} · {post.readTime}</span>
            </div>
            <h2 class="post-title"><a href={`/blog/${post.slug}`}>{post.title}</a></h2>
            <p class="post-excerpt">{post.excerpt}</p>
            <a href={`/blog/${post.slug}`} class="post-link">Leer artículo <span class="grad-text">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
<style>
.page-hero { padding: 10rem 0 4rem; }
.page-hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 1rem; }
.page-hero p { font-size: 1.1rem; color: var(--gray-400); max-width: 50ch; line-height: 1.7; }
.posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.post-card { padding: 2rem; display: flex; flex-direction: column; gap: 1rem; }
.post-featured { grid-column: 1 / -1; }
.post-meta { display: flex; align-items: center; gap: 12px; }
.post-cat { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); background: rgba(79,110,247,0.1); border: 1px solid var(--border); border-radius: var(--radius-full); padding: 3px 10px; }
.post-date { font-size: 0.8rem; color: var(--gray-500); }
.post-title { font-size: 1.1rem; line-height: 1.3; }
.post-featured .post-title { font-size: clamp(1.4rem, 2.5vw, 1.75rem); max-width: 28ch; }
.post-title a { transition: color 0.2s; }
.post-title a:hover { color: var(--blue); }
.post-excerpt { font-size: 0.875rem; color: var(--gray-400); line-height: 1.6; flex: 1; }
.post-link { font-size: 0.875rem; font-weight: 600; color: var(--white); }
@media (max-width: 900px) { .posts-grid { grid-template-columns: 1fr 1fr; } .post-featured { grid-column: 1 / -1; } }
@media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
</style>
