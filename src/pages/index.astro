<style>
/* ══ TOKENS ══ */
:root{
  --bg:#07091a;
  --bg2:#0b0f25;
  --card:rgba(255,255,255,.04);
  --bord:rgba(255,255,255,.08);
  --blue:#60a5fa;
  --purp:#7c3aed;
  --g:linear-gradient(90deg,#60a5fa,#8b5cf6);
  --g135:linear-gradient(135deg,#4f46e5,#7c3aed);
  --font-d:'Syne',sans-serif;
  --font-b:'DM Sans',sans-serif;
}
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap');

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:#fff;font-family:var(--font-b);-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
em{font-style:normal;background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

/* ══ CONTAINER ══ */
.container{width:100%;max-width:1240px;margin:0 auto;padding:0 2rem}

/* ══ BOTONES ══ */
.btn-prim{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--g135);color:#fff;
  font-family:var(--font-b);font-size:.9rem;font-weight:600;
  padding:13px 28px;border-radius:10px;border:none;
  box-shadow:0 6px 28px rgba(124,58,237,.4);
  transition:transform .2s,box-shadow .2s;cursor:pointer;white-space:nowrap;
}
.btn-prim:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(124,58,237,.55)}
.btn-sec{
  display:inline-flex;align-items:center;gap:10px;
  background:rgba(255,255,255,.06);color:rgba(255,255,255,.8);
  font-family:var(--font-b);font-size:.9rem;font-weight:600;
  padding:13px 28px;border-radius:10px;
  border:1px solid rgba(255,255,255,.14);
  transition:all .2s;cursor:pointer;white-space:nowrap;
}
.btn-sec:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.25);transform:translateY(-2px)}
.btn-out{
  display:inline-flex;align-items:center;gap:10px;
  background:transparent;color:#fff;
  font-family:var(--font-b);font-size:.9rem;font-weight:600;
  padding:13px 28px;border-radius:10px;
  border:1px solid var(--bord);
  transition:all .2s;cursor:pointer;white-space:nowrap;
}
.btn-out:hover{border-color:rgba(139,92,246,.5);background:rgba(139,92,246,.07);transform:translateY(-2px)}

/* ══ HELPERS ══ */
.section{padding:6rem 0}
.text-c{display:flex;flex-direction:column;align-items:center;text-align:center}
.tag{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin-bottom:.75rem}
.tag::before{content:'';display:block;width:22px;height:1.5px;background:var(--g);border-radius:2px}
.h2{font-family:var(--font-d);font-size:clamp(1.75rem,4vw,3rem);font-weight:800;line-height:1.1;letter-spacing:-.03em;color:#fff;margin-bottom:1rem}
.desc{color:rgba(255,255,255,.45);font-size:.95rem;line-height:1.7;max-width:58ch;margin-bottom:0}
.body-text{color:rgba(255,255,255,.5);font-size:.9rem;line-height:1.8}

/* ══ HERO ══ */
.hero{
  position:relative;
  display:flex;flex-direction:column;align-items:center;
  padding:7rem 2rem 0;
  overflow:hidden;
  background:var(--bg);
}

/* Fondo del hero */
.hero-bg{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.glow-center{
  position:absolute;top:-10%;left:50%;transform:translateX(-50%);
  width:900px;height:700px;border-radius:50%;
  background:radial-gradient(ellipse,rgba(124,58,237,.28) 0%,rgba(79,70,229,.12) 40%,transparent 70%);
  filter:blur(60px);
}
.glow-left{position:absolute;top:0;left:-150px;width:400px;height:400px;border-radius:50%;background:rgba(79,70,229,.1);filter:blur(80px)}
.glow-right{position:absolute;top:10%;right:-100px;width:350px;height:350px;border-radius:50%;background:rgba(139,92,246,.1);filter:blur(80px)}
.grid-overlay{
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(139,92,246,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(139,92,246,.06) 1px,transparent 1px);
  background-size:50px 50px;
  mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,black 30%,transparent 100%);
}

.hero-content{
  position:relative;z-index:1;
  display:flex;flex-direction:column;align-items:center;
  gap:1.75rem;max-width:900px;width:100%;
}

/* Social proof pill — igual que PowerAI */
.sp-pill{
  display:inline-flex;align-items:center;gap:12px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.1);
  border-radius:100px;padding:8px 20px 8px 8px;
  font-size:.82rem;font-weight:500;color:rgba(255,255,255,.7);
}
.sp-avs{display:flex}
.av{
  width:30px;height:30px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:.72rem;font-weight:800;color:#fff;
  margin-right:-8px;border:2px solid var(--bg);
}
.sp-avs .av:last-child{margin-right:0}

/* Headline — grande y centrado */
.hero-h1{
  font-family:var(--font-d);
  font-size:clamp(2.75rem,6.5vw,5.5rem);
  font-weight:800;line-height:1.06;letter-spacing:-.04em;
  text-align:center;color:#fff;
}
.hero-h1 .grad{background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

.hero-sub{
  color:rgba(255,255,255,.5);font-size:1.05rem;line-height:1.75;
  text-align:center;max-width:52ch;
}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}

/* Imagen dashboard emergiendo desde abajo */
.hero-img-wrap{
  position:relative;
  width:100%;max-width:1000px;
  margin-top:1rem;
  padding:0 1rem;
}
.img-glow{
  position:absolute;
  bottom:0;left:50%;transform:translateX(-50%);
  width:80%;height:200px;
  background:radial-gradient(ellipse,rgba(124,58,237,.4) 0%,transparent 70%);
  filter:blur(40px);pointer-events:none;z-index:0;
}
.img-frame{
  position:relative;z-index:1;
  border-radius:16px 16px 0 0;
  border:1px solid rgba(255,255,255,.1);
  border-bottom:none;
  overflow:visible;
  /* Efecto emergente — igual que PowerAI */
  box-shadow:
    0 -20px 60px rgba(124,58,237,.2),
    0 0 0 1px rgba(255,255,255,.06),
    inset 0 1px 0 rgba(255,255,255,.1);
}
.dashboard-img{
  width:100%;
  border-radius:14px 14px 0 0;
  display:block;
}
.float-l,.float-r{
  position:absolute;
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(7,9,26,.9);backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.1);border-radius:100px;
  padding:8px 16px;font-size:.78rem;font-weight:600;white-space:nowrap;
  z-index:2;
}
.float-l{top:-16px;left:24px;color:#f59e0b}
.float-r{top:-16px;right:24px;color:#22c55e}
.live-dot{width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 6px #22c55e;animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(1.6)}}

/* Ticker */
.ticker-wrap{
  width:100%;overflow:hidden;
  border-top:1px solid rgba(255,255,255,.06);
  padding:1.1rem 0;position:relative;z-index:1;
  margin-top:3rem;
}
.ticker-inner{display:flex;white-space:nowrap;gap:2rem;animation:tick 28s linear infinite}
.ticker-inner span{font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.22)}
.ticker-inner .sep{color:var(--blue);opacity:.8}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ══ STATS ══ */
.stats-section{padding:4rem 0;border-bottom:1px solid var(--bord)}
.stats-row{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:2rem;
  border:1px solid var(--bord);border-radius:16px;
  padding:2.5rem;background:var(--card);
}
.stat-box{text-align:center}
.snum{
  display:block;font-family:var(--font-d);
  font-size:clamp(2rem,4vw,3.25rem);font-weight:800;
  background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  line-height:1;margin-bottom:.5rem;
}
.stat-box p{font-size:.8rem;color:rgba(255,255,255,.38);line-height:1.4}

/* ══ STEPS ══ */
.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;width:100%;margin-top:2.5rem}
.step-card{
  background:var(--g135);padding:1.5px;border-radius:14px;
  display:flex;flex-direction:column;position:relative;
}
.step-card::before{content:'';position:absolute;inset:1.5px;background:var(--bg2);border-radius:12.5px;z-index:0}
.step-n,.step-card h3,.step-card p{position:relative;z-index:1}
.step-n{display:inline-block;align-self:flex-start;background:#161f2e;color:rgba(255,255,255,.45);font-size:.7rem;font-weight:700;padding:4px 12px;border-radius:6px;margin:1.5rem 1.5rem 0}
.step-card h3{font-family:var(--font-d);font-size:1rem;font-weight:800;color:#fff;padding:.7rem 1.5rem 0;line-height:1.25}
.step-card p{color:rgba(255,255,255,.45);font-size:.8rem;padding:.5rem 1.5rem 1.75rem;line-height:1.65}

/* ══ INFO ══ */
.info-section{padding:5rem 0}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
.info-rev{direction:rtl}
.info-rev>*{direction:ltr}
.info-img-col{display:flex;align-items:center;justify-content:center}
.info-img{width:100%;max-width:480px;border-radius:18px;box-shadow:0 20px 64px rgba(0,0,0,.5)}
.info-text-col{display:flex;flex-direction:column;gap:.75rem}
.info-text-col h2{font-family:var(--font-d);font-size:clamp(1.5rem,3vw,2.25rem);font-weight:800;line-height:1.2;letter-spacing:-.02em;color:#fff}

/* ══ TRUST ══ */
.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;width:100%;margin-top:2rem}
.tcard{background:var(--card);border:1px solid var(--bord);border-radius:14px;padding:1.5rem;display:flex;flex-direction:column;gap:.875rem;transition:border-color .2s,transform .2s}
.tcard:hover{border-color:rgba(139,92,246,.25);transform:translateY(-3px)}
.tstars{color:#f59e0b;font-size:.82rem;letter-spacing:2px}
.tquote{color:#cbd5e1;font-size:.8rem;line-height:1.65;flex:1;font-style:italic}
.tmeta{display:flex;align-items:center;gap:10px}
.tav{width:36px;height:36px;border-radius:50%;background:var(--g135);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.9rem;flex-shrink:0}
.tname{font-size:.82rem;font-weight:700;color:#fff}
.tloc{font-size:.72rem;color:rgba(255,255,255,.35)}
.tmetrics{display:flex;align-items:center;gap:1rem;padding-top:.75rem;border-top:1px solid rgba(255,255,255,.06)}
.tm{display:flex;flex-direction:column;gap:2px}
.tm strong{font-family:var(--font-d);font-size:1.1rem;font-weight:800;background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
.tm span{font-size:.68rem;color:rgba(255,255,255,.35)}
.tsep2{width:1px;height:28px;background:var(--bord)}

/* ══ SERVICIOS ══ */
.svc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--bord);border:1px solid var(--bord);border-radius:16px;overflow:hidden}
.svc-item{background:var(--bg2);padding:1.75rem 1.5rem;display:flex;flex-direction:column;gap:.6rem;transition:background .2s;color:#fff}
.svc-item:hover{background:#0f1a30}
.svc-item:hover .svc-arr{opacity:1;transform:translateX(0)}
.svc-ico{width:42px;height:42px;background:var(--g135);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.svc-ico img{width:22px;height:22px;filter:brightness(0) invert(1)}
.svc-item h4{font-family:var(--font-d);font-size:.9rem;font-weight:800;color:#fff;line-height:1.2}
.svc-item p{font-size:.78rem;color:rgba(255,255,255,.38);line-height:1.55;flex:1}
.svc-arr{font-size:.9rem;color:var(--blue);opacity:0;transform:translateX(-6px);transition:.2s;align-self:flex-start;margin-top:auto}
.svc-note{font-size:.85rem;color:rgba(255,255,255,.28);text-align:center;margin-top:1.75rem;max-width:60ch;margin-inline:auto}
.svc-note strong{color:rgba(255,255,255,.5)}

/* ══ CTA MID ══ */
.cta-mid{padding:5rem 0;background:rgba(79,70,229,.05);border-top:1px solid var(--bord);border-bottom:1px solid var(--bord)}
.cta-mid-inner{display:grid;grid-template-columns:1fr 360px;gap:4rem;align-items:center}
.cta-mid-text h2{font-family:var(--font-d);font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;line-height:1.15;letter-spacing:-.02em;margin-bottom:1rem}
.cta-mid-text p{color:rgba(255,255,255,.45);font-size:.9rem;line-height:1.75}
.cta-mid-img{position:relative;display:flex;align-items:center;justify-content:center}
.cta-mid-img img{max-height:280px;object-fit:contain;filter:drop-shadow(0 20px 50px rgba(124,58,237,.5));animation:flt 5s ease-in-out infinite}
@keyframes flt{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.cta-glow{position:absolute;inset:0;background:radial-gradient(circle,rgba(124,58,237,.25) 0%,transparent 65%);filter:blur(30px);pointer-events:none}

/* ══ PRECIOS ══ */
.pkg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.pkg-card{background:var(--card);border:1px solid var(--bord);border-radius:16px;padding:2rem;display:flex;flex-direction:column;gap:1.25rem;position:relative;overflow:hidden;transition:border-color .25s,transform .25s,box-shadow .25s}
.pkg-card:hover{border-color:rgba(139,92,246,.25);transform:translateY(-4px);box-shadow:0 20px 50px rgba(0,0,0,.25)}
.pkg-card.hot{border-color:rgba(124,58,237,.4);box-shadow:0 0 50px rgba(124,58,237,.1)}
.pkg-pop{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--g135);color:#fff;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 16px;border-radius:999px;white-space:nowrap}
.pkg-n{font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.25)}
.pkg-name{font-family:var(--font-d);font-size:1.2rem;font-weight:800;color:#fff}
.pkg-desc{font-size:.8rem;color:rgba(255,255,255,.4)}
.pkg-price{display:flex;flex-direction:column;gap:4px}
.pkg-price s{font-size:.78rem;color:rgba(255,255,255,.22)}
.pkg-pr{display:flex;align-items:baseline;gap:8px}
.pkg-pr strong{font-family:var(--font-d);font-size:2.25rem;font-weight:800;background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
.pkg-pr>span:first-of-type{font-size:.78rem;color:rgba(255,255,255,.3)}
.oferta{font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);background:rgba(96,165,250,.1);border:1px solid rgba(96,165,250,.2);border-radius:999px;padding:2px 8px}
.pkg-feats{list-style:none;display:flex;flex-direction:column;gap:9px;flex:1}
.pkg-feats li{display:flex;align-items:center;gap:10px;font-size:.82rem;color:rgba(255,255,255,.6)}
.chk{color:var(--blue);font-weight:700}
.pkg-foot{color:rgba(255,255,255,.2);font-size:.72rem;letter-spacing:.06em;text-align:center;margin-top:1.5rem}

/* ══ FAQ ══ */
.faq-wrap{max-width:720px;display:flex;flex-direction:column;gap:10px;width:100%}
.faq-item{background:var(--card);border:1px solid var(--bord);border-radius:12px;overflow:hidden;transition:border-color .2s}
.faq-item[open]{border-color:rgba(139,92,246,.25)}
.faq-sum{display:flex;align-items:center;gap:12px;padding:16px 20px;list-style:none;cursor:pointer}
.faq-sum::-webkit-details-marker{display:none}
.faq-q{flex:1;font-size:.875rem;font-weight:600;color:#fff}
.faq-item[open] .faq-q{background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.mac{display:flex;gap:5px;flex-shrink:0}
.d{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.d.r{background:#ff5f57}.d.y{background:#febc2e}.d.g{background:#28c840}
.faq-ico{margin-left:auto;color:rgba(255,255,255,.3);transition:transform .3s;flex-shrink:0}
.faq-item[open] .faq-ico{transform:rotate(180deg)}
.faq-ans{padding:14px 20px 18px;font-size:.85rem;color:rgba(255,255,255,.45);line-height:1.75;border-top:1px solid rgba(255,255,255,.05)}

/* ══ CONTACTO ══ */
.contact-form{background:var(--card);border:1px solid var(--bord);border-radius:16px;padding:2.25rem;display:flex;flex-direction:column;gap:1.1rem;width:100%;max-width:640px;margin:0 auto}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.ff{display:flex;flex-direction:column;gap:5px}
.ff label{font-size:.72rem;font-weight:600;color:rgba(255,255,255,.3);letter-spacing:.04em}
.ff input,.ff select,.ff textarea{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:11px 15px;font-family:var(--font-b);font-size:.875rem;color:#fff;outline:none;transition:border-color .2s,box-shadow .2s;resize:vertical;width:100%}
.ff input::placeholder,.ff textarea::placeholder{color:rgba(255,255,255,.2)}
.ff select option{background:#0b0f25}
.ff input:focus,.ff select:focus,.ff textarea:focus{border-color:rgba(139,92,246,.4);box-shadow:0 0 0 3px rgba(139,92,246,.08)}
.form-note{font-size:.75rem;color:rgba(255,255,255,.22);text-align:center}
.form-note a{color:var(--blue)}

/* ══ FOOTER ══ */
.footer{padding:4rem 0 0;border-top:1px solid var(--bord);margin-top:2rem}
.footer-inner{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;gap:3rem;padding-bottom:3rem}
.f-brand{display:flex;flex-direction:column;gap:.75rem}
.f-logo{font-family:var(--font-d);font-size:1.3rem;font-weight:800;color:#fff}
.f-logo em{background:var(--g);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.f-brand p{font-size:.8rem;color:rgba(255,255,255,.35);line-height:1.65;max-width:24ch}
.f-social{display:flex;gap:12px;margin-top:.5rem}
.f-social a{color:rgba(255,255,255,.3);transition:color .2s}
.f-social a:hover{color:var(--blue)}
.f-col{display:flex;flex-direction:column;gap:.6rem}
.f-title{font-size:.8rem;font-weight:700;color:#fff;margin-bottom:.25rem}
.f-col a{font-size:.8rem;color:rgba(255,255,255,.35);transition:color .2s}
.f-col a:hover{color:var(--blue)}
.copy{text-align:center;font-size:.72rem;color:rgba(255,255,255,.18);padding:1.5rem 0 2rem}

/* ══ RESPONSIVE ══ */
@media(max-width:1100px){
  .stats-row{grid-template-columns:repeat(2,1fr)}
  .steps-grid{grid-template-columns:1fr}
  .info-grid{grid-template-columns:1fr;gap:2.5rem;direction:ltr}
  .info-img{max-width:100%}
  .trust-grid{grid-template-columns:repeat(2,1fr)}
  .svc-grid{grid-template-columns:repeat(2,1fr)}
  .pkg-grid{grid-template-columns:1fr;max-width:420px;margin-inline:auto}
  .cta-mid-inner{grid-template-columns:1fr}
  .cta-mid-img{display:none}
  .footer-inner{grid-template-columns:1fr 1fr;gap:2rem}
  .f-brand{grid-column:1/-1}
}
@media(max-width:640px){
  .hero{padding:5rem 1rem 0}
  .trust-grid{grid-template-columns:1fr}
  .svc-grid{grid-template-columns:1fr}
  .stats-row{grid-template-columns:1fr 1fr;gap:1rem;padding:1.5rem}
  .form-row{grid-template-columns:1fr}
  .footer-inner{grid-template-columns:1fr}
}
</style>

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

/* ── HERO ── */
gsap.set(['#h-pill','#h-title','#h-sub','#h-ctas'], { opacity:0, y:24 });
gsap.set('#h-img', { opacity:0, y:40 });

gsap.timeline({ defaults:{ ease:'power3.out' } })
  .to('#h-pill',  { opacity:1, y:0, duration:.7 })
  .to('#h-title', { opacity:1, y:0, duration:.9 }, '-=.4')
  .to('#h-sub',   { opacity:1, y:0, duration:.7 }, '-=.5')
  .to('#h-ctas',  { opacity:1, y:0, duration:.6 }, '-=.4')
  .to('#h-img',   { opacity:1, y:0, duration:1, ease:'power2.out' }, '-=.3');

/* ── STAT COUNTERS ── */
document.querySelectorAll<HTMLElement>('.snum[data-to]').forEach(el => {
  const to  = parseInt(el.getAttribute('data-to')  || '0');
  const suf = el.getAttribute('data-suf') || '';
  ScrollTrigger.create({
    trigger: el, start: 'top 85%',
    onEnter(){
      gsap.to({ v:0 }, {
        v:to, duration:1.8, ease:'power2.out',
        onUpdate(){ el.textContent = (to>=1000 ? Math.round((this as any).targets()[0].v).toLocaleString('es-MX') : Math.round((this as any).targets()[0].v)) + suf; }
      });
    }
  });
});

/* ── SCROLL REVEALS ── */
const batch = (sel:string, opts = {}) =>
  ScrollTrigger.batch(sel, {
    start:'top 88%',
    onEnter: (els:HTMLElement[]) => gsap.fromTo(els,
      { opacity:0, y:28 },
      { opacity:1, y:0, duration:.7, stagger:.09, ease:'power3.out', ...opts }
    )
  });

batch('.stat-box');
batch('.step-card', { stagger:.1 });
batch('.tcard',     { stagger:.08 });
batch('.svc-item',  { stagger:.06 });
batch('.pkg-card',  { stagger:.1 });
batch('.faq-item',  { stagger:.07 });
batch('.reveal');

/* INFO: slide desde costado */
document.querySelectorAll<HTMLElement>('.reveal-left').forEach(el => {
  gsap.set(el, { opacity:0, x:-40 });
  ScrollTrigger.create({ trigger:el, start:'top 82%',
    onEnter:() => gsap.to(el, { opacity:1, x:0, duration:.9, ease:'power3.out' })
  });
});
document.querySelectorAll<HTMLElement>('.reveal-right').forEach(el => {
  gsap.set(el, { opacity:0, x:40 });
  ScrollTrigger.create({ trigger:el, start:'top 82%',
    onEnter:() => gsap.to(el, { opacity:1, x:0, duration:.9, ease:'power3.out' })
  });
});

/* ── PRICING TILT ── */
document.querySelectorAll<HTMLElement>('.pkg-card').forEach(card => {
  card.addEventListener('mousemove', (e:MouseEvent) => {
    const r = card.getBoundingClientRect();
    const rx =  ((e.clientY-(r.top +r.height/2))/r.height)*7;
    const ry = -((e.clientX-(r.left+r.width /2))/r.width )*7;
    gsap.to(card,{ rotateX:rx, rotateY:ry, duration:.35, ease:'power2.out', transformPerspective:700, overwrite:'auto' });
  });
  card.addEventListener('mouseleave',() =>
    gsap.to(card,{ rotateX:0, rotateY:0, duration:.5, ease:'back.out(1.5)', overwrite:'auto' })
  );
});
</script>