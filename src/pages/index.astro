---
import Layout from '../layouts/Layout.astro';
const B = 'https://marketingsolutionsmx.com/wp-content/uploads';
---

<Layout
  title="Agencia de Marketing en CDMX"
  description="En Marketing Solutions somos una agencia de marketing en CDMX que ayuda a emprendedores y empresas a fortalecer su presencia digital, conectar con su audiencia y generar oportunidades reales de crecimiento."
  canonical="/"
>

<!-- ════════════════════════════════
     HERO — centrado, estilo PowerAI
════════════════════════════════ -->
<section class="hero">

  <!-- Fondo: glow central + grid -->
  <div class="hero-bg" aria-hidden="true">
    <div class="glow-center"></div>
    <div class="glow-left"></div>
    <div class="glow-right"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="hero-content">

    <!-- Social proof pill — avatares + texto -->
    <div class="sp-pill" id="h-pill">
      <div class="sp-avs">
        <span class="av" style="background:linear-gradient(135deg,#4F6EF7,#8B5CF6)">M</span>
        <span class="av" style="background:linear-gradient(135deg,#8B5CF6,#ec4899)">L</span>
        <span class="av" style="background:linear-gradient(135deg,#4F6EF7,#06b6d4)">R</span>
        <span class="av" style="background:linear-gradient(135deg,#f59e0b,#ef4444)">K</span>
      </div>
      <span>+150 negocios en México confían en nosotros</span>
    </div>

    <!-- Headline principal -->
    <h1 class="hero-h1" id="h-title">
      Agencia de marketing<br />
      en CDMX enfocada en<br />
      crear presencia <span class="grad">real</span>
    </h1>

    <!-- Sub -->
    <p class="hero-sub" id="h-sub">
      Ayudamos a emprendedores y empresas a fortalecer su presencia digital,<br />
      conectar con su audiencia y generar oportunidades reales de crecimiento.
    </p>

    <!-- CTAs -->
    <div class="hero-ctas" id="h-ctas">
      <a href="#contacto" class="btn-prim">
        Consulta gratis
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="https://wa.me/525610341236" target="_blank" rel="noopener" class="btn-sec">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        WhatsApp
      </a>
    </div>

    <!-- Imagen dashboard emergiendo — igual que PowerAI -->
    <div class="hero-img-wrap" id="h-img">
      <div class="img-glow"></div>
      <div class="img-frame">
        <img
          src={`${B}/2026/05/Adobe-Express-file-1-1024x573.webp`}
          alt="Marketing Solutions MX — resultados reales"
          class="dashboard-img"
          loading="eager"
          width="1024" height="573"
        />
        <!-- Badge flotante izquierda -->
        <div class="float-l">
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1l1.5 3 3.3.5-2.4 2.3.6 3.2L7 8.5l-3 1.5.6-3.2L2.2 4.5 5.5 4z" fill="#f59e0b"/></svg>
          +40% ventas promedio
        </div>
        <!-- Badge flotante derecha -->
        <div class="float-r">
          <span class="live-dot"></span>
          SEO activo · 3,000+ leads
        </div>
      </div>
    </div>

  </div>

  <!-- Ticker -->
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-inner">
      {['Diseño Web','·','SEO Premium','·','Google Ads','·','META Ads','·','Redes Sociales','·','Email Marketing','·','Branding','·','Analítica','·'].map(t=>(
        <span class={t==='·'?'sep':''}>{t}</span>
      ))}
      {['Diseño Web','·','SEO Premium','·','Google Ads','·','META Ads','·','Redes Sociales','·','Email Marketing','·','Branding','·','Analítica','·'].map(t=>(
        <span class={t==='·'?'sep':''}>{t}</span>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     STATS — fila de números
════════════════════════════════ -->
<section class="stats-section">
  <div class="container">
    <div class="stats-row">
      {[
        {v:40,  s:'%+', l:'Incremento promedio en ventas'},
        {v:150, s:'+',  l:'Proyectos entregados'},
        {v:3000,s:'+',  l:'Leads generados para clientes'},
        {v:5,   s:'',   l:'Ciudades en México'},
      ].map(st=>(
        <div class="stat-box reveal">
          <strong class="snum" data-to={st.v} data-suf={st.s}>0{st.s}</strong>
          <p>{st.l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     ¿CÓMO TRABAJAMOS? — 3 steps
════════════════════════════════ -->
<section class="section" id="proceso">
  <div class="container text-c">
    <p class="tag">Metodología</p>
    <h2 class="h2"><em>¿Cómo</em> trabajamos?</h2>
    <p class="desc">Cada estrategia nace de un análisis profundo de tu negocio, mercado y oportunidades reales de crecimiento.</p>
    <div class="steps-grid">
      {[
        {n:'Paso 01', t:'Analizamos tu marca, mercado y competencia', d:'Diagnóstico completo para entender dónde está tu negocio y qué oportunidades reales existen en tu sector.'},
        {n:'Paso 02', t:'Creamos estrategias personalizadas',          d:'Nada de plantillas genéricas. Cada plan diseñado para tu negocio, tu audiencia y tus metas de crecimiento.'},
        {n:'Paso 03', t:'Ejecutamos, medimos y optimizamos',           d:'Reportes claros, acceso directo al equipo y ajustes constantes para maximizar cada peso de tu inversión.'},
      ].map(s=>(
        <div class="step-card reveal">
          <span class="step-n">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     INFO 1 — img izquierda
════════════════════════════════ -->
<section class="info-section">
  <div class="container info-grid">
    <div class="info-img-col reveal-left">
      <img src={`${B}/2026/03/Sin-titulo-4.webp`} alt="Estrategia digital" class="info-img" loading="lazy" />
    </div>
    <div class="info-text-col reveal-right">
      <p class="tag">Presencia digital real</p>
      <h2 class="h2">Haz que tus servicios brillen con nuestra <em>estrategia digital completa</em></h2>
      <p class="body-text">Diseñamos estrategias de marketing digital enfocadas en fortalecer la presencia de cada marca. No solo ejecutamos acciones — trabajamos en cómo se ve, cómo comunica y cómo se posiciona tu negocio frente a su audiencia ideal.</p>
      <a href="#contacto" class="btn-prim" style="margin-top:1.75rem;display:inline-flex;">Explorar servicios →</a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     INFO 2 — img derecha
════════════════════════════════ -->
<section class="info-section">
  <div class="container info-grid info-rev">
    <div class="info-text-col reveal-left">
      <p class="tag">Diseño web profesional</p>
      <h2 class="h2">Diseño web <em>profesional</em> que convierte visitas en clientes reales</h2>
      <p class="body-text">Creamos sitios modernos, ultrarrápidos y optimizados para SEO. Desde landing pages hasta e-commerce completos — sin contratos forzosos, sin letra chica, con soporte real y resultados medibles.</p>
      <a href="#precios" class="btn-prim" style="margin-top:1.75rem;display:inline-flex;">Ver paquetes →</a>
    </div>
    <div class="info-img-col reveal-right">
      <img src={`${B}/2026/02/renderizacion-3d-elementos-redes-sociales-1.webp`} alt="Diseño web" class="info-img" loading="lazy" />
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     TESTIMONIOS
════════════════════════════════ -->
<section class="section" id="clientes">
  <div class="container text-c">
    <p class="tag">Resultados reales</p>
    <h2 class="h2">+150 negocios en México <em>ya confían</em> en nosotros</h2>
    <p class="desc">Lo que dicen nuestros clientes refleja los resultados que entregamos.</p>
    <div class="trust-grid">
      {[
        {n:'Restaurante El Parador', l:'CDMX',   q:'En 3 meses duplicamos las reservaciones por Google. Antes no aparecíamos en el mapa, ahora somos los primeros.', m1:'+210%', l1:'Tráfico orgánico', m2:'2x',    l2:'Reservaciones'},
        {n:'Clínica DermaSkin',      l:'CDMX',   q:'Las campañas META generaron más leads en un mes que todo el año anterior. El equipo entiende nuestro sector.',    m1:'+340%', l1:'Leads generados',  m2:'-42%',  l2:'Costo por lead'},
        {n:'Inmobiliaria Horizonte', l:'Cancún', q:'Diseñaron nuestro sitio en 2 semanas y el SEO nos posicionó en #1 en 60 días. Resultados increíbles.',           m1:'60 días',l1:'Para rankear #1', m2:'+180%', l2:'Visitas al sitio'},
        {n:'Boutique Alma',          l:'Tulum',  q:'El branding y redes sociales transformaron nuestra presencia digital por completo. Nuevos clientes cada semana.', m1:'+90%',  l1:'Nuevos seguidores', m2:'3x',    l2:'Ventas online'},
      ].map(t=>(
        <div class="tcard reveal">
          <div class="tstars">★★★★★</div>
          <p class="tquote">"{t.q}"</p>
          <div class="tmeta">
            <div class="tav">{t.n[0]}</div>
            <div>
              <p class="tname">{t.n}</p>
              <p class="tloc">{t.l}</p>
            </div>
          </div>
          <div class="tmetrics">
            <div class="tm"><strong>{t.m1}</strong><span>{t.l1}</span></div>
            <div class="tsep2"></div>
            <div class="tm"><strong>{t.m2}</strong><span>{t.l2}</span></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     SERVICIOS — grid 4×2
════════════════════════════════ -->
<section class="section" id="servicios">
  <div class="container text-c">
    <p class="tag">Servicios</p>
    <h2 class="h2">Servicios de marketing digital para <em>hacer crecer tu negocio</em></h2>
    <p class="desc">Soluciones estratégicas para posicionar tu marca, atraer clientes y maximizar tu ROI.</p>
  </div>
  <div class="container">
    <div class="svc-grid">
      {[
        {href:'/servicios/redes-sociales', icon:`${B}/2026/02/svgviewer-output-9.svg`,  t:'Gestión Social',    d:'Contenido estratégico y dinámico para conectar con tu audiencia en redes sociales.'},
        {href:'/servicios/meta-ads',       icon:`${B}/2026/02/svgviewer-output-7.svg`,  t:'Campañas META',     d:'Anuncios de alta conversión en Facebook e Instagram para maximizar tu inversión.'},
        {href:'/servicios/seo',            icon:`${B}/2026/02/seo-svgrepo-com.svg`,      t:'SEO Premium',       d:'Primeros resultados en Google para atraer tráfico calificado de forma sostenida.'},
        {href:'/servicios/diseno-web',     icon:`${B}/2026/02/svgviewer-output-10.svg`, t:'Diseño Web',        d:'Sitios modernos y optimizados para convertir visitantes en clientes reales.'},
        {href:'/servicios/google-ads',     icon:'',                                      t:'Google Ads',        d:'Captura clientes en el momento exacto que te buscan en Google.'},
        {href:'/servicios/email-marketing',icon:'',                                      t:'Email Marketing',   d:'Secuencias automatizadas que nutren leads y generan ventas en piloto automático.'},
        {href:'/servicios/identidad-marca',icon:'',                                      t:'Branding',          d:'Logotipo, paleta y manual para construir una marca memorable y coherente.'},
        {href:'/servicios/analitica',      icon:'',                                      t:'Analítica',         d:'Medición en tiempo real para tomar decisiones basadas en datos reales.'},
      ].map(s=>(
        <a href={s.href} class="svc-item reveal">
          <div class="svc-ico">
            {s.icon
              ? <img src={s.icon} alt="" width="22" height="22" loading="lazy" />
              : <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="2" width="16" height="16" rx="4"/><path d="M7 10h6M10 7v6"/></svg>
            }
          </div>
          <div>
            <h4>{s.t}</h4>
            <p>{s.d}</p>
          </div>
          <span class="svc-arr">→</span>
        </a>
      ))}
    </div>
    <p class="svc-note reveal">Nuestros servicios se ajustan según el tipo de negocio, industria y objetivos — <strong>escalables y orientados a resultados.</strong></p>
  </div>
</section>

<!-- ════════════════════════════════
     CTA INTERMEDIA
════════════════════════════════ -->
<section class="cta-mid">
  <div class="container cta-mid-inner reveal">
    <div class="cta-mid-text">
      <p class="tag" style="color:#a78bfa">Agencia de Marketing · CDMX</p>
      <h2 class="h2">Construyamos la estrategia <em>correcta</em> para tu negocio</h2>
      <p class="body-text">Si buscas una agencia de marketing en CDMX que te ayude a crear presencia digital real y sostenible, en Marketing Solutions estamos listos para acompañarte.</p>
      <a href="#contacto" class="btn-prim" style="margin-top:1.5rem;display:inline-flex;">Quiero mi estrategia →</a>
    </div>
    <div class="cta-mid-img">
      <img src={`${B}/2026/02/renderizacion-3d-elementos-redes-sociales-1.webp`} alt="Marketing 3D" loading="lazy" />
      <div class="cta-glow"></div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════
     PRECIOS
════════════════════════════════ -->
<section class="section" id="precios">
  <div class="container text-c">
    <p class="tag">Precios</p>
    <h2 class="h2">Nuestros <em>paquetes y precios</em></h2>
    <p class="desc">Sin contratos forzosos, sin letra chica. Diseñados para cada etapa de tu negocio.</p>
  </div>
  <div class="container">
    <div class="pkg-grid">
      {[
        {n:'01', name:'Landing Express', desc:'Ideal para lanzamientos rápidos y campañas pagadas.',  price:'$4,000', before:'$5,500', feats:['Diseño UI/UX de alta conversión','Optimización ultra rápida (<1s)','Copywriting persuasivo','Integración con WhatsApp','Formulario de captura leads','1 mes de soporte técnico'], hot:false},
        {n:'02', name:'Business Site',   desc:'Autoridad digital para posicionarte localmente.',       price:'$5,500', before:'$7,500', feats:['6 Secciones profesionales','Estrategia SEO Local avanzada','Google Analytics 4 configurado','Integración Google Maps','Optimización para móviles','2 meses de soporte'],         hot:true },
        {n:'03', name:'E-Commerce Max',  desc:'Tu sistema completo de ventas online.',                 price:'$15,500',before:'$17,000',feats:['Tienda Shopify o Webflow','Pasarela Stripe / PayPal','Gestión de inventario','Automatización de correos','Recuperación de carritos','3 meses soporte premium'],              hot:false},
      ].map(pkg=>(
        <div class={`pkg-card reveal ${pkg.hot?'hot':''}`}>
          {pkg.hot && <div class="pkg-pop">Más popular</div>}
          <p class="pkg-n">Paquete {pkg.n}</p>
          <h3 class="pkg-name">{pkg.name}</h3>
          <p class="pkg-desc">{pkg.desc}</p>
          <div class="pkg-price">
            <s>{pkg.before} MXN</s>
            <div class="pkg-pr">
              <strong>{pkg.price}</strong>
              <span>MXN</span>
              <span class="oferta">Oferta</span>
            </div>
          </div>
          <ul class="pkg-feats">
            {pkg.feats.map(f=><li><span class="chk">✓</span>{f}</li>)}
          </ul>
          <a href="https://wa.me/525610341236" target="_blank" rel="noopener"
             class={pkg.hot?'btn-prim':'btn-out'}
             style="width:100%;justify-content:center;display:flex;margin-top:auto;">
            Iniciar Proyecto
          </a>
        </div>
      ))}
    </div>
    <p class="pkg-foot reveal">✓ Responsive &nbsp;·&nbsp; ✓ SEO &nbsp;·&nbsp; ✓ SSL &nbsp;·&nbsp; ✓ Speed &nbsp;·&nbsp; ✓ Soporte prioritario</p>
  </div>
</section>

<!-- ════════════════════════════════
     FAQ
════════════════════════════════ -->
<section class="section" id="faq">
  <div class="container text-c" style="margin-bottom:2.5rem">
    <p class="tag">FAQ</p>
    <h2 class="h2">Preguntas <em>frecuentes</em></h2>
  </div>
  <div class="container faq-wrap">
    {[
      {q:'¿Quiénes somos en Marketing Solutions?',  a:'Somos una agencia de marketing en México especializada en crear presencia digital real para marcas que buscan crecer, posicionarse y ser relevantes en el entorno digital.'},
      {q:'¿Qué hacemos exactamente?',                a:'Creamos estrategias de marketing digital enfocadas en fortalecer la presencia de las marcas. No solo ejecutamos acciones, sino que trabajamos en cómo se ve, cómo comunica y cómo se posiciona cada negocio frente a su audiencia.'},
      {q:'¿Trabajan con contratos forzosos?',        a:'No. Trabajamos con acuerdos mensuales sin permanencia mínima. Sin letra chica, sin sorpresas.'},
      {q:'¿Cuánto tarda en verse resultados?',       a:'En campañas pagadas los resultados son casi inmediatos. En SEO orgánico entre 3 y 6 meses. Siempre fijamos expectativas realistas desde el día uno.'},
      {q:'¿Trabajan con negocios pequeños?',         a:'Sí. Trabajamos con emprendedores, PyMEs y empresas medianas. Ajustamos el plan a tu etapa y presupuesto.'},
    ].map(f=>(
      <details class="faq-item reveal">
        <summary class="faq-sum">
          <div class="mac"><span class="d r"></span><span class="d y"></span><span class="d g"></span></div>
          <span class="faq-q">{f.q}</span>
          <svg class="faq-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <p class="faq-ans">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<!-- ════════════════════════════════
     CONTACTO
════════════════════════════════ -->
<section class="section" id="contacto">
  <div class="container text-c" style="margin-bottom:2.5rem">
    <p class="tag">Contacto</p>
    <h2 class="h2">Haz despegar tu <em>presencia digital</em></h2>
    <p class="desc">Cuéntanos sobre tu negocio y preparamos un plan personalizado sin costo ni compromiso.</p>
  </div>
  <div class="container">
    <form name="contacto" netlify class="contact-form">
      <div class="form-row">
        <div class="ff"><label>Nombre</label><input type="text" name="nombre" placeholder="Tu nombre" /></div>
        <div class="ff"><label>Empresa</label><input type="text" name="empresa" placeholder="Tu empresa" /></div>
      </div>
      <div class="ff"><label>Email *</label><input type="email" name="email" placeholder="tu@email.com" required /></div>
      <div class="ff"><label>Teléfono</label><input type="tel" name="telefono" placeholder="+52 55 0000 0000" /></div>
      <div class="ff">
        <label>Servicio de interés</label>
        <select name="servicio">
          <option value="">Selecciona...</option>
          {['Gestión de Redes Sociales','Diseño Web','SEO Premium','Google Ads','Campañas META','Email Marketing','Branding','Estrategia completa'].map(o=><option>{o}</option>)}
        </select>
      </div>
      <div class="ff"><label>Mensaje</label><textarea name="mensaje" rows="4" placeholder="Cuéntanos sobre tu negocio..."></textarea></div>
      <button type="submit" class="btn-prim" style="width:100%;justify-content:center;display:flex;">
        Enviar mensaje →
      </button>
      <p class="form-note">También por <a href="https://wa.me/525610341236" target="_blank" rel="noopener">WhatsApp</a> — respondemos en menos de 24h.</p>
    </form>
  </div>
</section>

<!-- ════════════════════════════════
     FOOTER
════════════════════════════════ -->
<footer class="footer">
  <div class="container footer-inner">
    <div class="f-brand">
      <span class="f-logo">marketing<em>solutions</em>mx.</span>
      <p>Especialistas en presencia digital real para marcas que quieren crecer en México.</p>
      <div class="f-social">
        <a href="https://www.facebook.com/share/1GW87woGfX/" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.instagram.com/mktg.solutionss" target="_blank" rel="noopener" aria-label="Instagram">
