---
import Layout from '../layouts/Layout.astro';

const testimonials = [
  { name: 'Restaurante El Parador', role: 'Dueño, CDMX', quote: 'En 3 meses duplicamos las reservaciones por Google. Antes no aparecíamos en el mapa, ahora somos los primeros.', metric1: '+210%', label1: 'Tráfico orgánico', metric2: '2x', label2: 'Reservaciones' },
  { name: 'Clínica DermaSkin', role: 'Directora médica, CDMX', quote: 'Las campañas META generaron más leads en un mes que todo el año anterior. El equipo entiende nuestro sector.', metric1: '+340%', label1: 'Leads generados', metric2: '-42%', label2: 'Costo por lead' },
  { name: 'Inmobiliaria Horizonte', role: 'Gerente comercial, Cancún', quote: 'Diseñaron nuestro sitio en 2 semanas y el posicionamiento en Google llegó en 60 días. Increíble rapidez.', metric1: '60 días', label1: 'Para rankear #1', metric2: '+180%', label2: 'Visitas al sitio' },
];

const services = [
  { icon: '📱', title: 'Gestión Social', desc: 'Contenido estratégico que conecta tu marca con su audiencia real.', href: '/servicios/redes-sociales', wide: false },
  { icon: '🎯', title: 'Campañas META', desc: 'Anuncios de alta conversión en Facebook e Instagram.', href: '/servicios/meta-ads', wide: false },
  { icon: '🔍', title: 'SEO Premium', desc: 'Primeros resultados en Google para atraer tráfico calificado de forma sostenida y sin pagar por clic.', href: '/servicios/seo', wide: true },
  { icon: '🌐', title: 'Diseño Web', desc: 'Sitios modernos y optimizados para convertir visitantes.', href: '/servicios/diseno-web', wide: false },
  { icon: '📣', title: 'Google Ads', desc: 'Captura clientes en el momento exacto que te buscan.', href: '/servicios/google-ads', wide: false },
  { icon: '✉️', title: 'Email Marketing', desc: 'Secuencias automatizadas que generan ventas en piloto.', href: '/servicios/email-marketing', wide: false },
  { icon: '🎨', title: 'Identidad de Marca', desc: 'Logotipo, paleta y manual para una marca memorable y coherente en todos los canales.', href: '/servicios/identidad-marca', wide: true },
];

const process = [
  { n: '01', title: 'Diagnóstico', desc: 'Analizamos tu marca, mercado y competencia para identificar oportunidades reales de crecimiento.' },
  { n: '02', title: 'Estrategia', desc: 'Diseñamos un plan personalizado. Sin plantillas genéricas. Solo lo que funciona para tu negocio.' },
  { n: '03', title: 'Ejecución y resultados', desc: 'Implementamos, medimos y optimizamos. Reportes claros, acceso directo al equipo. Sin sorpresas.' },
];

const packages = [
  { num: '01', name: 'Landing Express', desc: 'Para lanzamientos rápidos.', price: '$4,000', before: '$5,500', currency: 'MXN', features: ['Diseño UI/UX de alta conversión', 'Velocidad <1 segundo', 'Copywriting persuasivo', 'Integración WhatsApp', 'Formulario de captura', '1 mes soporte'], featured: false },
  { num: '02', name: 'Business Site', desc: 'Autoridad y posicionamiento local.', price: '$5,500', before: '$7,500', currency: 'MXN', features: ['6 secciones profesionales', 'SEO Local avanzado', 'Google Analytics 4', 'Google Maps integrado', 'Optimización móvil', '2 meses soporte'], featured: true },
  { num: '03', name: 'E-Commerce Max', desc: 'Tu sistema completo de ventas.', price: '$15,500', before: '$17,000', currency: 'MXN', features: ['Shopify o Webflow', 'Stripe / PayPal', 'Gestión de inventario', 'Emails automáticos', 'Recuperación carritos', '3 meses soporte premium'], featured: false },
];

const faqs = [
  { q: '¿Trabajan con contratos forzosos?', a: 'No. Acuerdos mensuales sin permanencia mínima. Sin letra chica ni sorpresas.' },
  { q: '¿Cuánto tarda en verse resultados?', a: 'En campañas pagadas los resultados son casi inmediatos. En SEO entre 3 y 6 meses. Siempre fijamos expectativas realistas desde el día uno.' },
  { q: '¿Trabajan con negocios pequeños?', a: 'Sí. Trabajamos con emprendedores, PyMEs y empresas medianas en toda la república. Ajustamos el plan a tu etapa y presupuesto.' },
  { q: '¿Qué incluye la consulta gratis?', a: '30 minutos analizando tu presencia digital actual y presentando un plan de acción concreto — sin compromiso.' },
  { q: '¿Tienen experiencia en mi industria?', a: 'Restaurantes, clínicas, inmobiliarias, despachos legales, e-commerce, turismo y más. Nos adaptamos a tu sector.' },
];
---

<Layout
  title="Agencia de Marketing en CDMX"
  description="En Marketing Solutions somos una agencia de marketing en CDMX que ayuda a emprendedores y empresas a fortalecer su presencia digital, conectar con su audiencia y generar oportunidades reales de crecimiento."
  canonical="/"
>

<!-- ══════════════════ HERO ══════════════════ -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hb-glow1"></div>
    <div class="hb-glow2"></div>
    <div class="hb-grid"></div>
  </div>

  <div class="container hero-inner">
    <!-- Social proof pill -->
    <div class="sp-pill">
      <div class="sp-avatars">
        <span class="sp-av" style="background:linear-gradient(135deg,#4F6EF7,#8B5CF6)">M</span>
        <span class="sp-av" style="background:linear-gradient(135deg,#8B5CF6,#ec4899)">L</span>
        <span class="sp-av" style="background:linear-gradient(135deg,#4F6EF7,#06b6d4)">R</span>
      </div>
      <span>+150 negocios en México confían en nosotros</span>
    </div>

    <h1>
      Agencia de marketing<br />
      en CDMX enfocada en<br />
      crear presencia <em>real</em>
    </h1>

    <p class="hero-sub">
      Ayudamos a emprendedores y empresas a fortalecer su presencia digital,
      conectar con su audiencia y generar oportunidades reales de crecimiento.
    </p>

    <div class="hero-actions">
      <a href="https://wa.me/525610341236" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
        Solicitar consulta gratis
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3.75 9h10.5M10.5 5.25 14.25 9l-3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a href="#servicios" class="btn btn-ghost-white">Ver servicios</a>
    </div>

    <!-- Stats row -->
    <div class="hero-stats">
      <div class="hs-item">
        <strong>+40%</strong>
        <span>Incremento promedio en ventas</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs-item">
        <strong>+150</strong>
        <span>Proyectos entregados</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs-item">
        <strong>5</strong>
        <span>Ciudades en México</span>
      </div>
      <div class="hs-div"></div>
      <div class="hs-item">
        <strong>Sin</strong>
        <span>Contratos forzosos</span>
      </div>
    </div>
  </div>

  <!-- Ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-inner">
      {['Diseño Web','SEO Premium','Google Ads','META Ads','Redes Sociales','Email Marketing','Branding','Analítica'].map(t => (
        <span>{t}<em> · </em></span>
      ))}
      {['Diseño Web','SEO Premium','Google Ads','META Ads','Redes Sociales','Email Marketing','Branding','Analítica'].map(t => (
        <span>{t}<em> · </em></span>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ TESTIMONIALS HERO ══════════════════ -->
<section class="section testi-section">
  <div class="container">
    <div class="section-label">
      <span class="label">Resultados reales</span>
    </div>
    <h2 class="section-h2">
      Resultados reales.<br />
      Historias <span class="grad-text">reales.</span>
    </h2>
    <p class="section-sub">Lo que dicen nuestros clientes refleja los resultados que entregamos.</p>

    <div class="testi-grid">
      {testimonials.map((t, i) => (
        <div class={`testi-card ${i === 0 ? 'testi-featured' : ''}`}>
          <div class="testi-quote">"{t.quote}"</div>
          <div class="testi-meta">
            <div class="testi-avatar">{t.name[0]}</div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-role">{t.role}</p>
            </div>
          </div>
          <div class="testi-metrics">
            <div class="tm-item">
              <span class="tm-n grad-text">{t.metric1}</span>
              <span class="tm-l">{t.label1}</span>
            </div>
            <div class="tm-sep"></div>
            <div class="tm-item">
              <span class="tm-n grad-text">{t.metric2}</span>
              <span class="tm-l">{t.label2}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ QUOTE MARQUEE ══════════════════ -->
<section class="quote-section">
  <div class="quote-track">
    <div class="quote-inner">
      <span>"Construimos presencia digital real para marcas que quieren crecer."</span>
      <em>★</em>
      <span>"Estrategia + Ejecución + Resultados."</span>
      <em>★</em>
      <span>"Sin contratos forzosos. Sin letra chica. Solo resultados."</span>
      <em>★</em>
      <span>"Construimos presencia digital real para marcas que quieren crecer."</span>
      <em>★</em>
      <span>"Estrategia + Ejecución + Resultados."</span>
      <em>★</em>
      <span>"Sin contratos forzosos. Sin letra chica. Solo resultados."</span>
      <em>★</em>
    </div>
  </div>
</section>

<!-- ══════════════════ SERVICIOS BENTO ══════════════════ -->
<section class="section" id="servicios">
  <div class="container">
    <div class="sh-row">
      <div>
        <span class="label">Servicios</span>
        <h2 class="section-h2">Todo lo que necesitas<br />para <span class="grad-text">crecer en digital</span></h2>
      </div>
      <p class="sh-right">Soluciones estratégicas diseñadas para posicionar tu marca, atraer clientes y maximizar tu retorno de inversión.</p>
    </div>

    <div class="bento">
      {services.map(s => (
        <a href={s.href} class={`bento-card ${s.wide ? 'bento-wide' : ''}`}>
          <span class="bc-icon">{s.icon}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <span class="bc-arrow grad-text">Ver servicio →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ PROCESO 3 PASOS ══════════════════ -->
<section class="section process-section" id="proceso">
  <div class="container">
    <div class="sh-row">
      <div>
        <span class="label">Metodología</span>
        <h2 class="section-h2">Nuestro framework<br />de <span class="grad-text">3 pasos</span></h2>
      </div>
      <p class="sh-right">Como agencia de marketing en CDMX, definimos cada estrategia después de analizar a fondo tu modelo de negocio y mercado.</p>
    </div>

    <div class="process-list">
      {process.map((step, i) => (
        <div class="process-item">
          <div class="pi-num grad-text">{step.n}</div>
          <div class="pi-body">
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
          {i < process.length - 1 && <div class="pi-line" aria-hidden="true"></div>}
        </div>
      ))}
    </div>

    <div class="process-cta">
      <a href="https://wa.me/525610341236" target="_blank" rel="noopener" class="btn btn-primary">
        Quiero mi diagnóstico gratis
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ══════════════════ PRECIOS ══════════════════ -->
<section class="section" id="precios">
  <div class="container">
    <div style="text-align:center;margin-bottom:3.5rem;">
      <span class="label" style="justify-content:center;">Precios</span>
      <h2 class="section-h2">Paquetes <span class="grad-text">sin contratos</span> forzosos</h2>
      <p class="section-sub">Diseñados para cada etapa de tu negocio. Sin letra chica, sin sorpresas.</p>
    </div>

    <div class="pricing-grid">
      {packages.map(pkg => (
        <div class={`pricing-card ${pkg.featured ? 'pricing-featured' : ''}`}>
          {pkg.featured && <div class="pricing-badge">Más popular</div>}
          <p class="pkg-num grad-text">Paquete {pkg.num}</p>
          <h3>{pkg.name}</h3>
          <p class="pkg-desc">{pkg.desc}</p>
          <div class="pkg-price-block">
            <s class="pkg-before">{pkg.before} {pkg.currency}</s>
            <div class="pkg-main">
              <span class="pkg-amount">{pkg.price}</span>
              <div>
                <span class="pkg-currency">{pkg.currency}</span>
                <span class="pkg-offer">Oferta</span>
              </div>
            </div>
          </div>
          <ul class="pkg-features">
            {pkg.features.map(f => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="https://wa.me/525610341236" target="_blank" rel="noopener"
             class={`btn ${pkg.featured ? 'btn-primary' : 'btn-outline'}`}
             style="width:100%;justify-content:center;">
            Iniciar Proyecto
          </a>
        </div>
      ))}
    </div>

    <div class="pkg-badges">
      {['✓ Responsive','✓ SEO','✓ SSL','✓ Speed optimizado','✓ Soporte prioritario'].map(b => (
        <span>{b}</span>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════ FAQ + CTA LATERAL ══════════════════ -->
<section class="section faq-section">
  <div class="container">
    <div class="faq-layout">
      <div class="faq-left">
        <span class="label">FAQ</span>
        <h2 class="section-h2">Preguntas <span class="grad-text">frecuentes</span></h2>
        <p>Todo lo que necesitas saber sobre cómo trabajamos y lo que podemos hacer por tu negocio.</p>
        <div class="faq-cta-box">
          <p>¿Tienes más preguntas?</p>
          <a href="https://wa.me/525610341236" target="_blank" rel="noopener" class="btn btn-primary">Contáctanos →</a>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-q">
              {faq.q}
              <svg class="faq-ico" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="faq-a">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════ CTA FINAL ══════════════════ -->
<section class="cta-final">
  <div class="cf-glow" aria-hidden="true"></div>
  <div class="container cf-inner">
    <div class="sp-pill" style="margin:0 auto 2rem;">
      <div class="sp-avatars">
        <span class="sp-av" style="background:linear-gradient(135deg,#4F6EF7,#8B5CF6)">M</span>
        <span class="sp-av" style="background:linear-gradient(135deg,#8B5CF6,#ec4899)">L</span>
        <span class="sp-av" style="background:linear-gradient(135deg,#4F6EF7,#06b6d4)">R</span>
      </div>
      <span>+150 negocios ya crecen con nosotros</span>
    </div>
    <h2>
      Haz despegar tu<br />
      presencia <span class="grad-text">digital</span>
    </h2>
    <p>Si buscas una agencia de marketing en CDMX que te ayude a crear presencia digital real y sostenible, estamos listos para acompañarte.</p>
    <div class="cf-actions">
      <a href="https://wa.me/525610341236" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
        Consulta gratis por WhatsApp
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      </a>
      <a href="mailto:contacto@marketingsolutionsmx.com" class="btn btn-outline">Enviar un correo</a>
    </div>
  </div>
</section>

</Layout>

<style>
/* ══ HERO ══ */
.hero{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding-top:72px;overflow:hidden}
.hero-bg{position:absolute;inset:0;pointer-events:none}
.hb-glow1{position:absolute;top:-20%;left:30%;width:700px;height:700px;background:radial-gradient(circle,rgba(79,110,247,.22) 0%,transparent 65%);border-radius:50%}
.hb-glow2{position:absolute;top:10%;right:10%;width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,.15) 0%,transparent 65%);border-radius:50%}
.hb-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(79,110,247,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(79,110,247,.05) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 80% 70% at 50% 0%,black 30%,transparent 100%)}
.hero-inner{position:relative;z-index:1;padding:5rem 0 3rem;display:flex;flex-direction:column;align-items:flex-start;gap:2rem}

/* Social proof pill */
.sp-pill{display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:100px;padding:8px 16px 8px 8px;font-size:.82rem;font-weight:500;color:var(--gray-300)}
.sp-avatars{display:flex}
.sp-av{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;color:#fff;margin-right:-8px;border:2px solid var(--bg-deep)}
.sp-avatars .sp-av:last-child{margin-right:0}

.hero-inner h1{font-size:clamp(2.75rem,6.5vw,5.5rem);font-weight:800;line-height:1.06;letter-spacing:-.035em}
.hero-inner h1 em{font-style:normal;background:var(--grad-text);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-sub{font-size:1.1rem;color:var(--gray-400);max-width:50ch;line-height:1.75}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}

.btn-lg{padding:16px 32px;font-size:1rem}
.btn-ghost-white{display:inline-flex;align-items:center;gap:8px;padding:16px 28px;border-radius:var(--radius-full);font-size:1rem;font-weight:600;color:var(--gray-300);border:1.5px solid rgba(255,255,255,.12);background:transparent;transition:var(--transition)}
.btn-ghost-white:hover{color:#fff;border-color:rgba(255,255,255,.3)}

.hero-stats{display:flex;align-items:center;gap:2rem;padding:1.5rem 2rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-lg);flex-wrap:wrap}
.hs-item{display:flex;flex-direction:column;gap:3px}
.hs-item strong{font-size:1.5rem;font-weight:800;background:var(--grad-text);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1}
.hs-item span{font-size:.78rem;color:var(--gray-400)}
.hs-div{width:1px;height:36px;background:rgba(255,255,255,.1)}

/* Ticker */
.ticker{width:100%;overflow:hidden;border-top:1px solid var(--border);padding:1rem 0;margin-top:auto;position:relative;z-index:1}
.ticker-inner{display:flex;white-space:nowrap;animation:ticker 25s linear infinite}
.ticker-inner span{font-size:.8rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gray-500);padding:0 1rem}
.ticker-inner em{color:var(--blue);font-style:normal}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ══ SECCIONES COMUNES ══ */
.section{padding:var(--section-gap) 0}
.label{display:inline-flex;align-items:center;gap:8px;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--blue);margin-bottom:1rem}
.section-h2{font-size:clamp(2rem,4vw,3rem);font-weight:800;line-height:1.1;letter-spacing:-.025em;margin-bottom:1rem}
.section-sub{color:var(--gray-400);font-size:1rem;line-height:1.7;max-width:55ch}
.section-label{margin-bottom:.5rem}
.sh-row{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:end;margin-bottom:3.5rem}
.sh-right{color:var(--gray-400);font-size:1rem;line-height:1.7}

/* ══ TESTIMONIALS ══ */
.testi-section{background:var(--bg-dark)}
.testi-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:1.25rem;margin-top:3rem}
.testi-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-xl);padding:2rem;display:flex;flex-direction:column;gap:1.5rem;transition:border-color .2s,transform .2s}
